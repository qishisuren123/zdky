# AutoResearch V3 local credentials template
# Copy to .env or export the variables in your shell. Never commit real values.

# ============================================================
# Quickest path: fill only these three and you can run the full
# pipeline with a single OpenAI-compatible endpoint. This overrides
# all other provider settings below — every model role (idea
# generation, review, planning) routes to this one endpoint.
# ============================================================
AUTORESEARCH_API_BASE_URL=
AUTORESEARCH_API_KEY=
AUTORESEARCH_API_MODEL=gpt-4o-mini

# ============================================================
# Advanced: multi-provider setup (skip if you filled in the three
# variables above). Leave AUTORESEARCH_CONFIG unset to use
# config.example.json directly, or copy it to config.local.json first.
# ============================================================
AUTORESEARCH_CONFIG=./config.local.json
AUTORESEARCH_DATA_DIR=./data
AUTORESEARCH_LOG_DIR=./logs
AUTORESEARCH_OUTPUT_DIR=./outputs

# OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini / Vertex Gemini
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GEMINI_VERTEX_PROJECT_ID=
GEMINI_VERTEX_LOCATION=global

# Search / research tools
TAVILY_API_KEY=

# Optional Twitter/X collection; prefer cookies or read-only auth.
TWITTER_EMAIL=
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_AUTH_TOKEN=
TWITTER_COOKIES_PATH=./twitter_cookies.local.json

# Optional proxy. Leave empty to disable.
AUTORESEARCH_PROXY_URL=
